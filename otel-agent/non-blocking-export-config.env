# OpenTelemetry 非阻塞導出配置
# 用於配置所有微服務的非阻塞導出機制

# 基本 OpenTelemetry 配置
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# OTLP 導出器配置
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4327
OTEL_EXPORTER_OTLP_TIMEOUT=30000
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# 非阻塞導出配置
OTEL_BSP_SCHEDULE_DELAY=500
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_EXPORT_TIMEOUT=30000
OTEL_BSP_MAX_EXPORT_TIMEOUT=30000

# 指標導出配置 (非阻塞)
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_METRIC_EXPORT_TIMEOUT=30000

# 資源配置
OTEL_RESOURCE_ATTRIBUTES_POD_NAME=${HOSTNAME}
OTEL_RESOURCE_ATTRIBUTES=service.namespace=microservices,deployment.environment=production

# JVM 和記憶體配置
OTEL_JAVAAGENT_ENABLED=true
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true

# 取樣配置 - 減少負載
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# 批次處理器配置 - 實作背壓控制
OTEL_BSP_SCHEDULE_DELAY=500
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# 錯誤處理和重試配置
OTEL_EXPORTER_OTLP_RETRY_ENABLED=true
OTEL_EXPORTER_OTLP_RETRY_INITIAL_BACKOFF=1s
OTEL_EXPORTER_OTLP_RETRY_MAX_BACKOFF=5s
OTEL_EXPORTER_OTLP_RETRY_MAX_ATTEMPTS=3

# 熔斷器配置
OTEL_EXPORTER_OTLP_CIRCUIT_BREAKER_ENABLED=true
OTEL_EXPORTER_OTLP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
OTEL_EXPORTER_OTLP_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
OTEL_EXPORTER_OTLP_CIRCUIT_BREAKER_TIMEOUT=60s

# 效能優化配置
OTEL_JAVA_GLOBAL_AUTOCONFIGURE_ENABLED=true
OTEL_INSTRUMENTATION_METHODS_INCLUDE=""
OTEL_INSTRUMENTATION_EXPERIMENTAL_SPAN_SUPPRESSION_STRATEGY=semconv

# 日誌配置
OTEL_LOGS_EXPORTER=otlp
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_ENABLED=true