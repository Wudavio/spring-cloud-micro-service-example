# auth-service OpenTelemetry 配置 - development 環境
# 自動生成於 Sat Jan  3 23:06:29 CST 2026
# 
# 此檔案由以下模板組合而成:
# - 環境配置: /Users/wuzhengwei/spring-cloud-micro-service-example/otel-agent/config-management/environments/development.env
# - 服務模板: /Users/wuzhengwei/spring-cloud-micro-service-example/otel-agent/config-management/services/auth-service.template

# Auth Service 服務特定配置模板
# 此檔案包含 Auth Service 的特定儀表化配置

# 服務識別
OTEL_SERVICE_NAME=auth-service
OTEL_SERVICE_VERSION=1.0.0

# Spring Security 儀表化 (Auth Service 的核心功能)
OTEL_INSTRUMENTATION_SPRING_SECURITY_ENABLED=true

# JWT 和認證相關儀表化
OTEL_INSTRUMENTATION_SPRING_WEB_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBMVC_ENABLED=true

# HTTP 客戶端儀表化
OTEL_INSTRUMENTATION_RESTTEMPLATE_ENABLED=true
OTEL_INSTRUMENTATION_APACHE_HTTPCLIENT_ENABLED=true

# 資料庫儀表化 (Auth Service 使用資料庫存儲用戶資訊)
OTEL_INSTRUMENTATION_JDBC_ENABLED=true
OTEL_INSTRUMENTATION_HIBERNATE_ENABLED=true
OTEL_INSTRUMENTATION_JPA_ENABLED=true

# HTTP 標頭傳播配置 (Auth Service 處理認證，需要特別注意安全標頭)
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_RESPONSE=x-trace-id,x-span-id
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,user-agent,x-forwarded-for
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=x-trace-id,x-span-id

# 敏感資料過濾 (Auth Service 處理敏感資訊)
OTEL_INSTRUMENTATION_HTTP_CAPTURE_REQUEST_HEADERS=false
OTEL_INSTRUMENTATION_HTTP_CAPTURE_RESPONSE_HEADERS=false

# 資源屬性 (Auth Service 特定)
OTEL_RESOURCE_ATTRIBUTES_SERVICE=service.name=auth-service,service.role=authentication,service.tier=core

# Auth Service 特定的 Span 屬性限制 (避免洩露敏感資訊)
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=32

# 環境特定配置
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_JAVAAGENT_DEBUG=true
OTEL_LOG_LEVEL=DEBUG
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
OTEL_BSP_EXPORT_TIMEOUT=15000
OTEL_BSP_SCHEDULE_DELAY=2000
OTEL_BSP_MAX_QUEUE_SIZE=1024
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=development,service.namespace=microservices-dev
OTEL_EXPORTER_OTLP_COMPRESSION=none
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=true

# 通用 OpenTelemetry 配置
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# 跨服務追蹤關聯配置
OTEL_PROPAGATORS=tracecontext,baggage,b3,b3multi
OTEL_PROPAGATORS_DEFAULT=tracecontext,baggage

# Java Agent 配置
OTEL_JAVAAGENT_CONFIGURATION_FILE=/app/otel-config.properties
JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

# 最終資源屬性組合
OTEL_RESOURCE_ATTRIBUTES=${OTEL_RESOURCE_ATTRIBUTES_BASE:-deployment.environment=development,service.namespace=microservices},${OTEL_RESOURCE_ATTRIBUTES_SERVICE:-service.name=auth-service},service.version=1.0.0,service.instance.id=auth-service-${HOSTNAME:-1}

