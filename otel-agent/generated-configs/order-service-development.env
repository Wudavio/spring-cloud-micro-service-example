# order-service OpenTelemetry 配置 - development 環境
# 自動生成於 Sat Jan  3 23:06:30 CST 2026
# 
# 此檔案由以下模板組合而成:
# - 環境配置: /Users/wuzhengwei/spring-cloud-micro-service-example/otel-agent/config-management/environments/development.env
# - 服務模板: /Users/wuzhengwei/spring-cloud-micro-service-example/otel-agent/config-management/services/order-service.template

# Order Service 服務特定配置模板
# 此檔案包含 Order Service 的特定儀表化配置

# 服務識別
OTEL_SERVICE_NAME=order-service
OTEL_SERVICE_VERSION=1.0.0

# OpenFeign 儀表化 (Order Service 使用 Feign 調用其他服務)
OTEL_INSTRUMENTATION_OPENFEIGN_ENABLED=true

# HTTP 客戶端儀表化
OTEL_INSTRUMENTATION_RESTTEMPLATE_ENABLED=true
OTEL_INSTRUMENTATION_APACHE_HTTPCLIENT_ENABLED=true
OTEL_INSTRUMENTATION_OKHTTP_ENABLED=true

# 資料庫儀表化
OTEL_INSTRUMENTATION_JDBC_ENABLED=true
OTEL_INSTRUMENTATION_HIBERNATE_ENABLED=true
OTEL_INSTRUMENTATION_JPA_ENABLED=true

# Spring Boot 相關儀表化
OTEL_INSTRUMENTATION_SPRING_WEB_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBMVC_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_DATA_ENABLED=true

# 對等服務映射 (Order Service 的下游服務)
OTEL_INSTRUMENTATION_COMMON_PEER_SERVICE_MAPPING=product-service=product-service,inventory-service=inventory-service,auth-service=auth-service

# HTTP 標頭傳播配置
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,authorization
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_RESPONSE=x-trace-id,x-span-id
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,user-agent,authorization
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=x-trace-id,x-span-id

# 資源屬性 (Order Service 特定)
OTEL_RESOURCE_ATTRIBUTES_SERVICE=service.name=order-service,service.role=order-management,service.tier=core

# Order Service 特定的業務指標
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true

# 重試機制儀表化 (Order Service 有重試邏輯)
OTEL_INSTRUMENTATION_SPRING_RETRY_ENABLED=true

# 事務管理儀表化

# 環境特定配置
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_JAVAAGENT_DEBUG=true
OTEL_LOG_LEVEL=DEBUG
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
OTEL_BSP_EXPORT_TIMEOUT=15000
OTEL_BSP_SCHEDULE_DELAY=2000
OTEL_BSP_MAX_QUEUE_SIZE=1024
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=development,service.namespace=microservices-dev
OTEL_EXPORTER_OTLP_COMPRESSION=none
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=true

# 通用 OpenTelemetry 配置
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# 跨服務追蹤關聯配置
OTEL_PROPAGATORS=tracecontext,baggage,b3,b3multi
OTEL_PROPAGATORS_DEFAULT=tracecontext,baggage

# Java Agent 配置
OTEL_JAVAAGENT_CONFIGURATION_FILE=/app/otel-config.properties
JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

# 最終資源屬性組合
OTEL_RESOURCE_ATTRIBUTES=${OTEL_RESOURCE_ATTRIBUTES_BASE:-deployment.environment=development,service.namespace=microservices},${OTEL_RESOURCE_ATTRIBUTES_SERVICE:-service.name=order-service},service.version=1.0.0,service.instance.id=order-service-${HOSTNAME:-1}

