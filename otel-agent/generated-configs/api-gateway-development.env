# api-gateway OpenTelemetry 配置 - development 環境
# 自動生成於 Sat Jan  3 23:06:29 CST 2026
# 
# 此檔案由以下模板組合而成:
# - 環境配置: /Users/wuzhengwei/spring-cloud-micro-service-example/otel-agent/config-management/environments/development.env
# - 服務模板: /Users/wuzhengwei/spring-cloud-micro-service-example/otel-agent/config-management/services/api-gateway.template

# API Gateway 服務特定配置模板
# 此檔案包含 API Gateway 的特定儀表化配置

# 服務識別
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=1.0.0

# API Gateway 特定的儀表化配置
OTEL_INSTRUMENTATION_SPRING_CLOUD_GATEWAY_ENABLED=true
OTEL_INSTRUMENTATION_REACTOR_NETTY_ENABLED=true
OTEL_INSTRUMENTATION_NETTY_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBFLUX_ENABLED=true

# 路由和負載均衡儀表化
OTEL_INSTRUMENTATION_SPRING_CLOUD_ENABLED=true
OTEL_INSTRUMENTATION_RIBBON_ENABLED=true

# HTTP 客戶端儀表化 (Gateway 需要調用所有下游服務)
OTEL_INSTRUMENTATION_RESTTEMPLATE_ENABLED=true
OTEL_INSTRUMENTATION_APACHE_HTTPCLIENT_ENABLED=true
OTEL_INSTRUMENTATION_OKHTTP_ENABLED=true

# 對等服務映射 (API Gateway 的所有下游服務)
OTEL_INSTRUMENTATION_COMMON_PEER_SERVICE_MAPPING=product-service=product-service,order-service=order-service,inventory-service=inventory-service,auth-service=auth-service,config-server=config-server,eureka-server=eureka-server

# HTTP 標頭傳播配置 (Gateway 是入口點，需要啟動和傳播追蹤)
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,authorization,x-forwarded-for,user-agent
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_RESPONSE=x-trace-id,x-span-id,x-response-time
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,user-agent,x-forwarded-for,authorization,x-real-ip
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=x-trace-id,x-span-id,x-response-time

# Gateway 特定的追蹤配置
OTEL_INSTRUMENTATION_HTTP_KNOWN_METHODS=GET,POST,PUT,DELETE,PATCH,HEAD,OPTIONS,TRACE
OTEL_INSTRUMENTATION_HTTP_CAPTURE_REQUEST_HEADERS=true
OTEL_INSTRUMENTATION_HTTP_CAPTURE_RESPONSE_HEADERS=true

# 安全性配置 (Gateway 處理認證)
OTEL_INSTRUMENTATION_SPRING_SECURITY_ENABLED=true

# 資源屬性 (Gateway 特定)

# 環境特定配置
DEPLOYMENT_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_JAVAAGENT_DEBUG=true
OTEL_LOG_LEVEL=DEBUG
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
OTEL_BSP_EXPORT_TIMEOUT=15000
OTEL_BSP_SCHEDULE_DELAY=2000
OTEL_BSP_MAX_QUEUE_SIZE=1024
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=development,service.namespace=microservices-dev
OTEL_EXPORTER_OTLP_COMPRESSION=none
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=true

# 通用 OpenTelemetry 配置
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# 跨服務追蹤關聯配置
OTEL_PROPAGATORS=tracecontext,baggage,b3,b3multi
OTEL_PROPAGATORS_DEFAULT=tracecontext,baggage

# Java Agent 配置
OTEL_JAVAAGENT_CONFIGURATION_FILE=/app/otel-config.properties
JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

# 最終資源屬性組合
OTEL_RESOURCE_ATTRIBUTES=${OTEL_RESOURCE_ATTRIBUTES_BASE:-deployment.environment=development,service.namespace=microservices},${OTEL_RESOURCE_ATTRIBUTES_SERVICE:-service.name=api-gateway},service.version=1.0.0,service.instance.id=api-gateway-${HOSTNAME:-1}

