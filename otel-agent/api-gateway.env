# API Gateway OpenTelemetry 配置
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=microservices,service.instance.id=api-gateway-1

# OpenTelemetry Collector 端點
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# 指標配置
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=30000

# 追蹤配置
OTEL_TRACES_EXPORTER=otlp
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# 跨服務追蹤關聯配置（API Gateway 是入口點，需要啟動追蹤）
OTEL_PROPAGATORS=tracecontext,baggage,b3,b3multi
OTEL_PROPAGATORS_DEFAULT=tracecontext,baggage

# HTTP 標頭傳播配置（API Gateway 需要傳播追蹤上下文到所有下游服務）
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,authorization
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_RESPONSE=x-trace-id,x-span-id
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,user-agent,x-forwarded-for,authorization
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=x-trace-id,x-span-id

# Spring Cloud Gateway 儀表化
OTEL_INSTRUMENTATION_SPRING_CLOUD_GATEWAY_ENABLED=true
OTEL_INSTRUMENTATION_REACTOR_NETTY_ENABLED=true
OTEL_INSTRUMENTATION_NETTY_ENABLED=true

# 服務間通信儀表化（Gateway 路由到所有微服務）
OTEL_INSTRUMENTATION_RESTTEMPLATE_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBFLUX_ENABLED=true
OTEL_INSTRUMENTATION_APACHE_HTTPCLIENT_ENABLED=true

# 對等服務映射（API Gateway 的所有下游服務）
OTEL_INSTRUMENTATION_COMMON_PEER_SERVICE_MAPPING=product-service=product-service,order-service=order-service,inventory-service=inventory-service,auth-service=auth-service

# 日誌配置
OTEL_LOGS_EXPORTER=otlp

# Java Agent 配置
OTEL_JAVAAGENT_CONFIGURATION_FILE=/app/otel-config.properties
JAVA_TOOL_OPTIONS=-javaagent:/app/opentelemetry-javaagent.jar

# 除錯模式
OTEL_JAVAAGENT_DEBUG=false