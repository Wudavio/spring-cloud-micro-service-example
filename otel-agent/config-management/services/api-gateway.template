# API Gateway 服務特定配置模板
# 此檔案包含 API Gateway 的特定儀表化配置

# 服務識別
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=${SERVICE_VERSION:-1.0.0}

# API Gateway 特定的儀表化配置
OTEL_INSTRUMENTATION_SPRING_CLOUD_GATEWAY_ENABLED=true
OTEL_INSTRUMENTATION_REACTOR_NETTY_ENABLED=true
OTEL_INSTRUMENTATION_NETTY_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBFLUX_ENABLED=true

# 路由和負載均衡儀表化
OTEL_INSTRUMENTATION_SPRING_CLOUD_ENABLED=true
OTEL_INSTRUMENTATION_RIBBON_ENABLED=true

# HTTP 客戶端儀表化 (Gateway 需要調用所有下游服務)
OTEL_INSTRUMENTATION_RESTTEMPLATE_ENABLED=true
OTEL_INSTRUMENTATION_APACHE_HTTPCLIENT_ENABLED=true
OTEL_INSTRUMENTATION_OKHTTP_ENABLED=true

# 對等服務映射 (API Gateway 的所有下游服務)
OTEL_INSTRUMENTATION_COMMON_PEER_SERVICE_MAPPING=product-service=product-service,order-service=order-service,inventory-service=inventory-service,auth-service=auth-service,config-server=config-server,eureka-server=eureka-server

# HTTP 標頭傳播配置 (Gateway 是入口點，需要啟動和傳播追蹤)
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,authorization,x-forwarded-for,user-agent
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_RESPONSE=x-trace-id,x-span-id,x-response-time
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,user-agent,x-forwarded-for,authorization,x-real-ip
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=x-trace-id,x-span-id,x-response-time

# Gateway 特定的追蹤配置
OTEL_INSTRUMENTATION_HTTP_KNOWN_METHODS=GET,POST,PUT,DELETE,PATCH,HEAD,OPTIONS,TRACE
OTEL_INSTRUMENTATION_HTTP_CAPTURE_REQUEST_HEADERS=true
OTEL_INSTRUMENTATION_HTTP_CAPTURE_RESPONSE_HEADERS=true

# 安全性配置 (Gateway 處理認證)
OTEL_INSTRUMENTATION_SPRING_SECURITY_ENABLED=true

# 資源屬性 (Gateway 特定)
OTEL_RESOURCE_ATTRIBUTES_SERVICE=service.name=api-gateway,service.role=gateway,service.tier=edge