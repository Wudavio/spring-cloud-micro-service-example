# Order Service 服務特定配置模板
# 此檔案包含 Order Service 的特定儀表化配置

# 服務識別
OTEL_SERVICE_NAME=order-service
OTEL_SERVICE_VERSION=${SERVICE_VERSION:-1.0.0}

# OpenFeign 儀表化 (Order Service 使用 Feign 調用其他服務)
OTEL_INSTRUMENTATION_OPENFEIGN_ENABLED=true

# HTTP 客戶端儀表化
OTEL_INSTRUMENTATION_RESTTEMPLATE_ENABLED=true
OTEL_INSTRUMENTATION_APACHE_HTTPCLIENT_ENABLED=true
OTEL_INSTRUMENTATION_OKHTTP_ENABLED=true

# 資料庫儀表化
OTEL_INSTRUMENTATION_JDBC_ENABLED=true
OTEL_INSTRUMENTATION_HIBERNATE_ENABLED=true
OTEL_INSTRUMENTATION_JPA_ENABLED=true

# Spring Boot 相關儀表化
OTEL_INSTRUMENTATION_SPRING_WEB_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_WEBMVC_ENABLED=true
OTEL_INSTRUMENTATION_SPRING_DATA_ENABLED=true

# 對等服務映射 (Order Service 的下游服務)
OTEL_INSTRUMENTATION_COMMON_PEER_SERVICE_MAPPING=product-service=product-service,inventory-service=inventory-service,auth-service=auth-service

# HTTP 標頭傳播配置
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,authorization
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_CLIENT_RESPONSE=x-trace-id,x-span-id
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_REQUEST=traceparent,tracestate,baggage,x-trace-id,x-span-id,user-agent,authorization
OTEL_INSTRUMENTATION_HTTP_CAPTURE_HEADERS_SERVER_RESPONSE=x-trace-id,x-span-id

# 資源屬性 (Order Service 特定)
OTEL_RESOURCE_ATTRIBUTES_SERVICE=service.name=order-service,service.role=order-management,service.tier=core

# Order Service 特定的業務指標
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true

# 重試機制儀表化 (Order Service 有重試邏輯)
OTEL_INSTRUMENTATION_SPRING_RETRY_ENABLED=true

# 事務管理儀表化
OTEL_INSTRUMENTATION_SPRING_TX_ENABLED=true