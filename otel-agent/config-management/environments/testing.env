# OpenTelemetry 測試環境配置
# 此檔案包含測試環境的預設配置值

# 環境識別
DEPLOYMENT_ENVIRONMENT=testing

# OpenTelemetry Collector 端點 (測試環境)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-test:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# 取樣配置 (測試環境使用 50% 取樣)
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.5

# 指標導出間隔 (測試環境中等頻率)
OTEL_METRIC_EXPORT_INTERVAL=15000

# 除錯模式 (測試環境關閉)
OTEL_JAVAAGENT_DEBUG=false

# 日誌級別 (測試環境適中日誌)
OTEL_LOG_LEVEL=INFO

# 批次處理配置 (測試環境中等批次)
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512
OTEL_BSP_EXPORT_TIMEOUT=20000
OTEL_BSP_SCHEDULE_DELAY=3000
OTEL_BSP_MAX_QUEUE_SIZE=1536

# 資源屬性
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=testing,service.namespace=microservices-test

# 安全性配置 (測試環境使用壓縮)
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# 效能配置 (測試環境平衡效能和可觀測性)
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true

# 測試環境特定配置
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=false
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true

# 測試環境的重試配置
OTEL_EXPORTER_OTLP_RETRY_ENABLED=true
OTEL_EXPORTER_OTLP_RETRY_MAX_ATTEMPTS=3