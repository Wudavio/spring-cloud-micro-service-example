# OpenTelemetry 預發布環境配置
# 此檔案包含預發布環境的預設配置值

# 環境識別
DEPLOYMENT_ENVIRONMENT=staging

# OpenTelemetry Collector 端點 (預發布環境)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-staging:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# 取樣配置 (預發布環境使用 10% 取樣)
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# 指標導出間隔 (預發布環境較低頻率)
OTEL_METRIC_EXPORT_INTERVAL=30000

# 除錯模式 (預發布環境關閉)
OTEL_JAVAAGENT_DEBUG=false

# 日誌級別 (預發布環境基本日誌)
OTEL_LOG_LEVEL=WARN

# 批次處理配置 (預發布環境較大批次)
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=1024
OTEL_BSP_EXPORT_TIMEOUT=30000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048

# 資源屬性
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=staging,service.namespace=microservices-staging

# 安全性配置 (預發布環境使用壓縮)
OTEL_EXPORTER_OTLP_COMPRESSION=gzip

# 效能配置 (預發布環境優先效能)
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true

# 預發布環境特定配置
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=false
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=false

# 預發布環境的重試和容錯配置
OTEL_EXPORTER_OTLP_RETRY_ENABLED=true
OTEL_EXPORTER_OTLP_RETRY_MAX_ATTEMPTS=5
OTEL_EXPORTER_OTLP_RETRY_INITIAL_BACKOFF=1s
OTEL_EXPORTER_OTLP_RETRY_MAX_BACKOFF=30s

# 記憶體和效能限制
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=128
OTEL_SPAN_EVENT_COUNT_LIMIT=128
OTEL_SPAN_LINK_COUNT_LIMIT=128