# OpenTelemetry 生產環境配置
# 此檔案包含生產環境的預設配置值

# 環境識別
DEPLOYMENT_ENVIRONMENT=production

# OpenTelemetry Collector 端點 (生產環境)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# 取樣配置 (生產環境使用 1% 取樣以減少開銷)
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.01

# 指標導出間隔 (生產環境最低頻率)
OTEL_METRIC_EXPORT_INTERVAL=60000

# 除錯模式 (生產環境關閉)
OTEL_JAVAAGENT_DEBUG=false

# 日誌級別 (生產環境僅錯誤日誌)
OTEL_LOG_LEVEL=ERROR

# 批次處理配置 (生產環境最大批次以提高效能)
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=2048
OTEL_BSP_EXPORT_TIMEOUT=60000
OTEL_BSP_SCHEDULE_DELAY=10000
OTEL_BSP_MAX_QUEUE_SIZE=4096

# 資源屬性
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=production,service.namespace=microservices

# 安全性配置 (生產環境使用壓縮和 TLS)
OTEL_EXPORTER_OTLP_COMPRESSION=gzip
OTEL_EXPORTER_OTLP_INSECURE=false

# 效能配置 (生產環境最優化效能)
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true

# 生產環境特定配置
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=false
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=false

# 生產環境的重試和容錯配置
OTEL_EXPORTER_OTLP_RETRY_ENABLED=true
OTEL_EXPORTER_OTLP_RETRY_MAX_ATTEMPTS=10
OTEL_EXPORTER_OTLP_RETRY_INITIAL_BACKOFF=2s
OTEL_EXPORTER_OTLP_RETRY_MAX_BACKOFF=60s

# 記憶體和效能限制 (生產環境嚴格限制)
OTEL_BSP_MAX_QUEUE_SIZE=4096
OTEL_SPAN_ATTRIBUTE_COUNT_LIMIT=64
OTEL_SPAN_EVENT_COUNT_LIMIT=64
OTEL_SPAN_LINK_COUNT_LIMIT=64

# 生產環境的資源限制
OTEL_ATTRIBUTE_VALUE_LENGTH_LIMIT=1024
OTEL_ATTRIBUTE_COUNT_LIMIT=128

# 生產環境的安全性配置
OTEL_EXPORTER_OTLP_HEADERS=api-key=${OTEL_API_KEY}

# 生產環境的監控配置
OTEL_INSTRUMENTATION_RUNTIME_TELEMETRY_ENABLED=true
OTEL_INSTRUMENTATION_RUNTIME_TELEMETRY_JAVA8_ENABLED=true

# 生產環境的錯誤處理
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_PROPAGATORS_DEFAULT=tracecontext,baggage