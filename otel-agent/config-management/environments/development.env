# OpenTelemetry 開發環境配置
# 此檔案包含開發環境的預設配置值

# 環境識別
DEPLOYMENT_ENVIRONMENT=development

# 服務配置 (將由服務特定配置覆蓋)
OTEL_SERVICE_NAME=${SERVICE_NAME:-unknown-service}
OTEL_SERVICE_VERSION=${SERVICE_VERSION:-1.0.0}

# OpenTelemetry Collector 端點 (本地開發)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# 取樣配置 (開發環境使用 100% 取樣以便除錯)
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# 指標導出間隔 (開發環境較頻繁)
OTEL_METRIC_EXPORT_INTERVAL=10000

# 除錯模式 (開發環境啟用)
OTEL_JAVAAGENT_DEBUG=true

# 日誌級別 (開發環境詳細日誌)
OTEL_LOG_LEVEL=DEBUG

# 批次處理配置 (開發環境較小批次)
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256
OTEL_BSP_EXPORT_TIMEOUT=15000
OTEL_BSP_SCHEDULE_DELAY=2000
OTEL_BSP_MAX_QUEUE_SIZE=1024

# 資源屬性
OTEL_RESOURCE_ATTRIBUTES_BASE=deployment.environment=development,service.namespace=microservices-dev

# 安全性配置 (開發環境較寬鬆)
OTEL_EXPORTER_OTLP_COMPRESSION=none

# 效能配置 (開發環境優先除錯而非效能)
OTEL_INSTRUMENTATION_COMMON_DEFAULT_ENABLED=true

# 開發環境特定的儀表化配置
OTEL_INSTRUMENTATION_EXPERIMENTAL_ENABLED=true
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true